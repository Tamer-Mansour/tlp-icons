{
  "name": "tlp-icons",
  "version": "0.1.1",
  "description": "6,620 free, open-source animated SVG icons in 35 categories (Lucide, Tabler and tlp originals), as one <tlp-icon> web component for HTML, React, Angular and Vue.",
  "license": "MIT",
  "homepage": "https://tlp-icons.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tamer-Mansour/tlp-icons.git"
  },
  "bugs": {
    "url": "https://github.com/Tamer-Mansour/tlp-icons/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "element": [
        "./dist/tlp-icon.d.ts"
      ],
      "tlp-icon.js": [
        "./dist/tlp-icon.d.ts"
      ],
      "jsx": [
        "./dist/jsx.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/tlp-icon.d.ts",
      "default": "./dist/tlp-icon.js"
    },
    "./tlp-icon.js": {
      "types": "./dist/tlp-icon.d.ts",
      "default": "./dist/tlp-icon.js"
    },
    "./jsx": {
      "types": "./dist/jsx.d.ts",
      "default": "./dist/jsx.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./css": "./dist/tlp-icons.css",
    "./tlp-icons.css": "./dist/tlp-icons.css",
    "./icons/*": "./dist/icons/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/tlp-icons.json",
    "!dist/tlp-icons.all.js",
    "!dist/size-report.json",
    "!dist/motion-rules.json",
    "!dist/build-report.json",
    "!dist/svg",
    "LICENSE",
    "NOTICE.md",
    "licenses"
  ],
  "sideEffects": [
    "./dist/tlp-icon.js",
    "./dist/element.js",
    "./dist/tlp-icons.all.js",
    "./dist/tlp-icons.runtime.js",
    "*.css"
  ],
  "keywords": [
    "icons",
    "animated-icons",
    "svg",
    "web-component",
    "lucide",
    "tabler",
    "react",
    "angular",
    "vue"
  ],
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "build": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "prepublishOnly": "node scripts/build.mjs",
    "test:browser": "node test/browser/run.mjs",
    "setup:browser": "node scripts/setup-browser.mjs",
    "dev": "npm --prefix web run dev"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
