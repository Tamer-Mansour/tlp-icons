{
  "name": "tlp-icons-data",
  "version": "0.5.0",
  "description": "The full tlp-icons set: one JSON file with every icon's SVG, motion, category, tags and source, plus one ES module per category (icons/<category>.js) and the offline single-file bundle (tlp-icons.all.js).",
  "license": "MIT",
  "homepage": "https://tlp-icons.netlify.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tamer-Mansour/tlp-icons.git",
    "directory": "packages/tlp-icons-data"
  },
  "bugs": {
    "url": "https://github.com/Tamer-Mansour/tlp-icons/issues"
  },
  "type": "module",
  "main": "./tlp-icons.json",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./tlp-icons.json"
    },
    "./tlp-icons.json": {
      "types": "./index.d.ts",
      "default": "./tlp-icons.json"
    },
    "./tlp-icons.all.js": "./tlp-icons.all.js",
    "./icons/*": "./icons/*",
    "./package.json": "./package.json"
  },
  "files": [
    "tlp-icons.json",
    "tlp-icons.all.js",
    "icons",
    "index.d.ts",
    "LICENSE",
    "NOTICE.md",
    "licenses"
  ],
  "sideEffects": [
    "./tlp-icons.all.js"
  ],
  "keywords": [
    "icons",
    "svg",
    "icon-data",
    "tlp-icons"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
